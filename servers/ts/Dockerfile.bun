# Bun's best version: the same request handling (src/app.ts) as the Node server, served by
# Bun.serve with Bun's built-in Postgres, Redis and S3 clients (src/server-bun.ts).
FROM oven/bun:1.4.4-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN bun install --production
COPY src ./src
ENV NODE_ENV=production
EXPOSE 8080
CMD ["bun", "src/server-bun.ts"]
